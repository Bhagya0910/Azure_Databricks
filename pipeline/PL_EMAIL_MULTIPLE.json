{
	"name": "PL_EMAIL_MULTIPLE",
	"properties": {
		"activities": [
			{
				"name": "SEND_EMAIL",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "EMAIL_BODY_SETUP",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": "https://prod-06.centralindia.logic.azure.com:443/workflows/4f8f8a08c5e34d688bdcfdb24c220aa3/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=pT8GWsIZIIekF892B1I06bMNAFk1g1ijrRnzPnfAM_I",
					"body": {
						"value": "@variables('Body')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "EMAIL_BODY_SETUP",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "EMAIL_BODY",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "EMAIL_SUBJECT",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Body",
					"value": {
						"value": "{\"Email_Recepient\": \"@{pipeline().parameters.email_recepient}\",\n\"Subject\": \"@{variables('email_subject')}\",\n\"Body\": \"@{variables('email_body')}\"\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "EMAIL_SUBJECT",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_subject",
					"value": {
						"value": "ingestion completed",
						"type": "Expression"
					}
				}
			},
			{
				"name": "EMAIL_BODY",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_body",
					"value": {
						"value": "The ingestion process has been completed for all tables and below is the status:\n@{replace(string(pipeline().parameters.table_status),'\"','')}\n\npipeline Run Id = @{pipeline().parameters.consolidated_pipeline}",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"email_recepient": {
				"type": "string"
			},
			"table_status": {
				"type": "array"
			},
			"consolidated_pipeline": {
				"type": "string"
			}
		},
		"variables": {
			"Body": {
				"type": "String"
			},
			"email_subject": {
				"type": "String"
			},
			"email_body": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-10-28T17:48:40Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}